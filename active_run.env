# Which run the supervisors should keep alive. One file, so a new run is one
# edit rather than a path hardcoded into three scripts.
#
# env.sh defaults PCB_MODEL_OUTPUT_DIR to Model_v6_2_scratch_rtx -- the run
# that finished on 05-09. Anything that starts training without overriding it
# aims at that finished directory, which is how a Tier-1 run was pointed at the
# wrong output on 08-09. These values are exported before env.sh is sourced, so
# its `${VAR:-default}` defaults never apply.
PCB_ARRAY_DIR=/home/u117134c/data/pcb_v62_arrays_repaired
PCB_MODEL_OUTPUT_DIR=/home/u117134c/Models/Model_v6_2_tier1_rtx
